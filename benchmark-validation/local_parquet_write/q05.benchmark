name wide_serial_bytes
group local_parquet_write
subgroup wide

load
SET datafusion.execution.batch_size = 2048;
SET datafusion.execution.target_partitions = 1;
CREATE TABLE source_data AS SELECT concat(md5(CAST(value * 7 + 0 AS VARCHAR)), md5(CAST(value * 7 + 1 AS VARCHAR)), md5(CAST(value * 7 + 2 AS VARCHAR)), md5(CAST(value * 7 + 3 AS VARCHAR))) AS s0, concat(md5(CAST(value * 7 + 4 AS VARCHAR)), md5(CAST(value * 7 + 5 AS VARCHAR)), md5(CAST(value * 7 + 6 AS VARCHAR)), md5(CAST(value * 7 + 7 AS VARCHAR))) AS s1, concat(md5(CAST(value * 7 + 8 AS VARCHAR)), md5(CAST(value * 7 + 9 AS VARCHAR)), md5(CAST(value * 7 + 10 AS VARCHAR)), md5(CAST(value * 7 + 11 AS VARCHAR))) AS s2, concat(md5(CAST(value * 7 + 12 AS VARCHAR)), md5(CAST(value * 7 + 13 AS VARCHAR)), md5(CAST(value * 7 + 14 AS VARCHAR)), md5(CAST(value * 7 + 15 AS VARCHAR))) AS s3 FROM range(0, 131072);

init
SET datafusion.execution.parquet.allow_single_file_parallelism = false;
SET datafusion.execution.parquet.maximum_parallel_row_group_writers = 2;
SET datafusion.execution.parquet.maximum_buffered_record_batches_per_stream = 2;
RESET datafusion.execution.parquet.max_row_group_bytes;

run
COPY source_data TO '${WRITE_OUTPUT_DIR}/wide_serial_bytes.parquet' STORED AS PARQUET OPTIONS ('format.max_row_group_size' 1000000, 'format.max_row_group_bytes' 4194304);

cleanup
DROP TABLE source_data;
